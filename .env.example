# 이 파일은 키 이름만 담는다. 값은 커밋되지 않는 .env에 적는다.
# cp .env.example .env 후 값을 채운다.

# --- 로컬 PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 호스트 포트. 비우면 5433
POSTGRES_PORT=

# --- Prisma ---
# 형식: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public
DATABASE_URL=
