# 이 파일은 키 이름만 담는다. 값은 커밋되지 않는 .env에 적는다.
# cp .env.example .env 후 값을 채운다.

# --- 로컬 PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 호스트 포트. 비우면 5433
POSTGRES_PORT=

# --- Prisma ---
# 형식: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public
DATABASE_URL=

# --- 인증 (Better Auth + Google OAuth) — 설정 절차: docs/auth-setup.md ---
# 32자 이상 무작위 값. 생성: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 앱의 기준 URL. 로컬 개발: http://localhost:3000
BETTER_AUTH_URL=
# Google Cloud Console → OAuth 2.0 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini BYOK API 키 암호화 (architecture.md §8.1) ---
# AES-256-GCM 마스터 키: base64로 인코딩한 정확히 32바이트. 생성: openssl rand -base64 32
# 분실하면 저장된 키를 복호화할 수 없다. DB와 분리해 보관하고 Git에 올리지 않는다.
PROVIDER_KEY_ENCRYPTION_KEY=
# 키 교체 감지용 HMAC 비밀: 32자 이상 무작위 문자열. 생성: openssl rand -base64 32
KEY_FINGERPRINT_SECRET=
